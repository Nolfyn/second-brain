# Провайдер LLM: ollama (по умолчанию) | anthropic | openai
LLM_PROVIDER=ollama

# Локальная модель через Ollama
OLLAMA_MODEL=qwen2.5:7b
# Число слоёв на GPU (опционально, см. оllama ps)
# OLLAMA_NUM_GPU_LAYERS=99

# Claude API (LLM_PROVIDER=anthropic)
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI-совместимый endpoint: Kimi, OpenAI и др. (LLM_PROVIDER=openai)
# OPENAI_MODEL=kimi-k2-0905-preview
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_API_KEY=sk-...

# Пароль для зашифрованных .docx
# DOC_PASSWORD=secret

# Путь к LibreOffice для конвертации .doc (опционально)
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# Пути хранилищ (по умолчанию — корень проекта)
# BRAIN_CHROMA_DIR=C:\D\Programs\Code\second-brain\chroma_db
# BRAIN_SQLITE_PATH=C:\D\Programs\Code\second-brain\second_brain.db

# Модель реранкера (опционально)
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12
